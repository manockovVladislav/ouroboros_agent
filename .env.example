# Скопировать в .env и заполнить локально после определения провайдеров.
AUDIT_INSIGHT_ENV=development
AUDIT_INSIGHT_CONFIG=configs/config.yaml
AUDIT_INSIGHT_DATA_SOURCES=configs/data_sources.yaml
AUDIT_INSIGHT_OUTPUT_DIR=outputs
AUDIT_INSIGHT_KNOWLEDGE_DIR=knowledge
AUDIT_WEB_HOST=127.0.0.1
AUDIT_WEB_PORT=7860
AUDIT_AGENT_DEV_WORKTREE_ROOT=/tmp/audit-insight-improvements
# Задайте, только если Ouroboros server защищён паролем.
# OUROBOROS_NETWORK_PASSWORD=
# QDRANT_API_KEY=

# Внешний evaluator запускается отдельным процессом и сам владеет ground truth.
# AUDIT_EVALUATOR_ROOT=/path/to/audit-evaluator
# AUDIT_EVALUATOR_COMMAND=python -m audit_evaluator

# Не добавлять реальные секреты в этот файл.
# DATABASE_URL=
# LLM_API_KEY=
